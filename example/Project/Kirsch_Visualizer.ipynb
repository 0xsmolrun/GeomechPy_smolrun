{"nbformat":4,"nbformat_minor":5,"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.10.0"}},"cells":[{"cell_type":"markdown","metadata":{},"source":["# Kirsch Visualizer – Near-Wellbore Stresses\n","\n","Demonstration of the Kirsch solution for borehole wall stresses using GeomechPy.\n","\n","**Units:** psi\n","\n","This notebook visualizes hoop, radial and axial stresses around the wellbore for vertical and deviated wells."]},{"cell_type":"code","execution_count":1,"metadata":{},"outputs":[{"name":"stdout","output_type":"stream","text":["Imports OK\n"]}],"source":["import sys\n","from pathlib import Path\n","import numpy as np\n","import matplotlib.pyplot as plt\n","%matplotlib inline\n","\n","REPO_ROOT = Path.cwd().resolve()\n","if REPO_ROOT.name == \"Project\":\n","    REPO_ROOT = REPO_ROOT.parent.parent\n","sys.path.insert(0, str(REPO_ROOT))\n","\n","try:\n","    from geomechpy.near_wellbore_stresses import NearWellboreStressesCalculation\n","except ImportError:\n","    import importlib.util\n","    base = REPO_ROOT / \"geomechpy\"\n","    spec = importlib.util.spec_from_file_location(\"nws\", base / \"near_wellbore_stresses.py\")\n","    mod = importlib.util.module_from_spec(spec)\n","    spec.loader.exec_module(mod)\n","    NearWellboreStressesCalculation = mod.NearWellboreStressesCalculation\n","\n","print(\"Imports OK\")"]},{"cell_type":"markdown","metadata":{},"source":["## Input Parameters (psi)"]},{"cell_type":"code","execution_count":2,"metadata":{},"outputs":[{"data":{"text/plain":["SHMIN=6500.0 SHMAX=8500.0 SVERT=10000.0 PP=3000.0 PW=3500.0"]},"execution_count":2,"metadata":{},"output_type":"execute_result"}],"source":["SHMIN = 6500.0\n","SHMAX = 8500.0\n","SVERT = 10000.0\n","PORE_PRESSURE = 3000.0\n","MUD_PRESSURE = 3500.0\n","POISSON = 0.25\n","BIOT = 1.0\n","\n","print(f\"SHMIN={SHMIN} SHMAX={SHMAX} SVERT={SVERT} PP={PORE_PRESSURE} PW={MUD_PRESSURE}\")"]},{"cell_type":"markdown","metadata":{},"source":["## Calculate Kirsch stresses at borehole wall"]},{"cell_type":"code","execution_count":3,"metadata":{},"outputs":[{"data":{"text/plain":["theta range: 0-360 deg, 72 points"]},"execution_count":3,"metadata":{},"output_type":"execute_result"}],"source":["theta = np.linspace(0, 360, 72)\n","wall = NearWellboreStressesCalculation.calculate_kirsch_borehole_wall_stresses(\n","    shmin=SHMIN,\n","    shmax=SHMAX,\n","    sv=SVERT,\n","    pp=PORE_PRESSURE,\n","    pw=MUD_PRESSURE,\n","    poisson=POISSON,\n","    biot=BIOT,\n","    well_azimuth=0.0,\n","    well_inclination=0.0,\n","    theta_deg=theta.tolist(),\n")\n","print(f\"theta range: 0-360 deg, {len(theta)} points\")"]},{"cell_type":"markdown","metadata":{},"source":["## QC Plot 1 – Polar stress plots"]},{"cell_type":"code","execution_count":4,"metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 1200x400 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["theta_rad = np.deg2rad(theta)\n","fig, axes = plt.subplots(1, 3, figsize=(12, 4), subplot_kw=dict(projection='polar'))\n","axes[0].plot(theta_rad, wall['sigma_theta'], 'r-')\n","axes[0].set_title('Hoop σθ')\n","axes[1].plot(theta_rad, wall['sigma_r'], 'b-')\n","axes[1].set_title('Radial σr')\n","axes[2].plot(theta_rad, wall['sigma_z'], 'g-')\n","axes[2].set_title('Axial σz')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","metadata":{},"source":["## QC Plot 2 – Cartesian view"]},{"cell_type":"code","execution_count":5,"metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 1000x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, ax = plt.subplots(figsize=(10, 5))\n","ax.plot(theta, wall['sigma_theta'], 'r-', label='σθ hoop')\n","ax.plot(theta, wall['sigma_r'], 'b-', label='σr radial')\n","ax.plot(theta, wall['sigma_z'], 'g-', label='σz axial')\n","ax.set_xlabel('θ (deg)')\n","ax.set_ylabel('Stress (psi)')\n","ax.legend()\n","ax.grid(True, alpha=0.3)\n","ax.set_title('Kirsch wall stresses vs azimuth')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","metadata":{},"source":["## QC Plot 3 – Stress components"]},{"cell_type":"code","execution_count":6,"metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 1100x800 with 4 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, axes = plt.subplots(2, 2, figsize=(11, 8), sharex=True)\n","axes[0,0].plot(theta, wall['sigma_theta'], 'r-')\n","axes[0,0].set_ylabel('σθ (psi)')\n","axes[0,0].set_title('Hoop')\n","axes[0,1].plot(theta, wall['sigma_r'], 'b-')\n","axes[0,1].set_ylabel('σr (psi)')\n","axes[0,1].set_title('Radial')\n","axes[1,0].plot(theta, wall['sigma_z'], 'g-')\n","axes[1,0].set_ylabel('σz (psi)')\n","axes[1,0].set_xlabel('θ (deg)')\n","axes[1,0].set_title('Axial')\n","axes[1,1].plot(theta, wall.get('tau_theta_z', [0]*len(theta)), 'm-')\n","axes[1,1].set_ylabel('τθz (psi)')\n","axes[1,1].set_xlabel('θ (deg)')\n","axes[1,1].set_title('Shear')\n","for ax in axes.flat:\n","    ax.grid(True, alpha=0.3)\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","metadata":{},"source":["## QC Plot 4 – Vertical vs Inclined well"]},{"cell_type":"code","execution_count":7,"metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 1000x500 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["def run_kirsch(deviation):\n","    w = NearWellboreStressesCalculation.calculate_kirsch_borehole_wall_stresses(\n","        shmin=SHMIN, shmax=SHMAX, sv=SVERT, pp=PORE_PRESSURE, pw=MUD_PRESSURE,\n","        poisson=POISSON, biot=BIOT, well_azimuth=0.0, well_inclination=deviation,\n","        theta_deg=theta.tolist(),\n","    )\n","    return w\n","\n","w0 = run_kirsch(0.0)\n","w60 = run_kirsch(60.0)\n","\n","fig, axes = plt.subplots(1, 2, figsize=(10, 5), sharey=True)\n","axes[0].plot(theta, w0['sigma_theta'], 'r-', label='σθ')\n","axes[0].plot(theta, w0['sigma_r'], 'b-', label='σr')\n","axes[0].set_title('Vertical well')\n","axes[0].legend()\n","axes[0].set_xlabel('θ (deg)')\n","axes[0].set_ylabel('Stress (psi)')\n","axes[1].plot(theta, w60['sigma_theta'], 'r-', label='σθ')\n","axes[1].plot(theta, w60['sigma_r'], 'b-', label='σr')\n","axes[1].set_title('60° inclination')\n","axes[1].legend()\n","axes[1].set_xlabel('θ (deg)')\n","for ax in axes:\n","    ax.grid(True, alpha=0.3)\n","plt.tight_layout()\n","plt.show()"]}],"nbformat":4,"nbformat_minor":5}