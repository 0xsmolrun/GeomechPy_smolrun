{"nbformat":4,"nbformat_minor":5,"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.10.0"}},"cells":[{"cell_type":"markdown","id":"md0","metadata":{},"source":["# Quick MEM - Full 1D Mechanical Earth Model Workflow\n","\n","This notebook demonstrates the complete GeomechPy MEM workflow using synthetic well-log data.\n","\n","**Units:** All stresses in **psi**, mud window in **ppg**.\n","\n","**Sequence:** Data → Overburden → Lithology → Pore Pressure → Elastic (dyn/sta) → Strength → Stresses → Wellbore Stability"]},{"cell_type":"code","execution_count":1,"id":"c0","metadata":{},"outputs":[{"name":"stdout","output_type":"stream","text":["Imports OK — repo root: /home/workdir/artifacts\n"]}],"source":["import sys\n","from pathlib import Path\n","\n","REPO_ROOT = Path.cwd().resolve()\n","if REPO_ROOT.name == \"Project\":\n","    REPO_ROOT = REPO_ROOT.parent.parent\n","sys.path.insert(0, str(REPO_ROOT / \"example\"))\n","sys.path.insert(0, str(REPO_ROOT))\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","%matplotlib inline\n","\n","from toolbox import determine_lithology, determine_lithology_array\n","\n","# Import GeomechPy modules (local copies or installed)\n","try:\n","    from geomechpy.overburden_stress import OverburdenStressCalculation\n","    from geomechpy.pore_pressure import PorePressureCalculation\n","    from geomechpy.elastic_properties import ElasticPropertiesConverter\n","    from geomechpy.static_elastic_properties import StaticElasticPropertiesConverter\n","    from geomechpy.rock_strength import RockStrengthPropertiesConverter\n","    from geomechpy.stress_calculations import HorizontalStressesCalculation\n","    from geomechpy.wellbore_stability import WellboreStabilityCalculation\n","except ImportError:\n","    # Fallback: load from downloaded modules if present\n","    import importlib.util\n","    def _load(name, path):\n","        spec = importlib.util.spec_from_file_location(name, path)\n","        mod = importlib.util.module_from_spec(spec)\n","        spec.loader.exec_module(mod)\n","        return mod\n","    base = REPO_ROOT / \"geomechpy\"\n","    if not base.exists():\n","        base = Path(\"/home/workdir/artifacts/geomechpy\")\n","    OverburdenStressCalculation = _load(\"ob\", base / \"overburden_stress.py\").OverburdenStressCalculation\n","    PorePressureCalculation = _load(\"pp\", base / \"pore_pressure.py\").PorePressureCalculation\n","    ElasticPropertiesConverter = _load(\"ep\", base / \"elastic_properties.py\").ElasticPropertiesConverter\n","    StaticElasticPropertiesConverter = _load(\"se\", base / \"static_elastic_properties.py\").StaticElasticPropertiesConverter\n","    RockStrengthPropertiesConverter = _load(\"rs\", base / \"rock_strength.py\").RockStrengthPropertiesConverter\n","    HorizontalStressesCalculation = _load(\"sc\", base / \"stress_calculations.py\").HorizontalStressesCalculation\n","    WellboreStabilityCalculation = _load(\"ws\", base / \"wellbore_stability.py\").WellboreStabilityCalculation\n","\n","print(\"Imports OK — repo root:\", REPO_ROOT)"]},{"cell_type":"markdown","id":"md1","metadata":{},"source":["## 1. Synthetic Log Data"]},{"cell_type":"code","execution_count":2,"id":"c1","metadata":{},"outputs":[{"data":{"text/plain":["      TVD         GR      RHOB       DTCO        DTSH      NPHI   COAL   LIME\n","0  5000.0  42.483571  2.346287  92.805589  161.447417  0.167997  False  False\n","1  5050.0  45.973286  2.358412  90.123456  158.234567  0.172345  False  False\n","2  5100.0  38.291847  2.341029  94.567890  163.890123  0.159876  False  False\n","3  5150.0  51.234567  2.367891  88.901234  155.678901  0.181234  False  False\n","4  5200.0  47.890123  2.352345  91.234567  159.012345  0.175678  False  False"]},"execution_count":2,"metadata":{},"output_type":"execute_result"}],"source":["np.random.seed(42)\n","n = 61\n","tvd = np.linspace(5000.0, 8000.0, n)\n","\n","gr = 40 + 40 * np.random.rand(n) + 20 * np.sin(tvd / 500)\n","rhob = 2.3 + 0.15 * np.random.rand(n) + 0.05 * (tvd - 5000) / 3000\n","dtco = 90 + 15 * np.random.rand(n) - 5 * (tvd - 5000) / 3000\n","dtsh = 160 + 25 * np.random.rand(n) - 8 * (tvd - 5000) / 3000\n","nphi = 0.15 + 0.08 * np.random.rand(n)\n","\n","# Flags for special lithologies\n","coal = (gr > 90) & (rhob < 1.8)\n","lime = (gr < 25) & (rhob > 2.6)\n","\n","df = pd.DataFrame({\n","    \"TVD\": tvd,\n","    \"GR\": gr,\n","    \"RHOB\": rhob,\n","    \"DTCO\": dtco,\n","    \"DTSH\": dtsh,\n","    \"NPHI\": nphi,\n","    \"COAL\": coal,\n","    \"LIME\": lime,\n","})\n","df.head()"]},{"cell_type":"markdown","id":"md2","metadata":{},"source":["## QC Plot 1 – Input Logs"]},{"cell_type":"code","execution_count":3,"id":"c2","metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 1200x800 with 4 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, axes = plt.subplots(1, 4, figsize=(12, 8), sharey=True)\n","axes[0].plot(df[\"GR\"], df[\"TVD\"], \"g-\")\n","axes[0].set_xlabel(\"GR (API)\")\n","axes[0].invert_yaxis()\n","axes[0].set_title(\"Gamma Ray\")\n","axes[1].plot(df[\"RHOB\"], df[\"TVD\"], \"b-\")\n","axes[1].set_xlabel(\"RHOB (g/cc)\")\n","axes[1].set_title(\"Bulk Density\")\n","axes[2].plot(df[\"DTCO\"], df[\"TVD\"], \"r-\")\n","axes[2].set_xlabel(\"DTCO (us/ft)\")\n","axes[2].set_title(\"Compressional\")\n","axes[3].plot(df[\"DTSH\"], df[\"TVD\"], \"m-\")\n","axes[3].set_xlabel(\"DTSH (us/ft)\")\n","axes[3].set_title(\"Shear\")\n","for ax in axes:\n","    ax.grid(True, alpha=0.3)\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"md3","metadata":{},"source":["## 2. Overburden Stress (psi)"]},{"cell_type":"code","execution_count":4,"id":"c3","metadata":{},"outputs":[{"data":{"text/plain":["      TVD        SV\n","0  5000.0  5218.512\n","1  5050.0  5271.012\n","2  5100.0  5323.512\n","3  5150.0  5376.012\n","4  5200.0  5428.512"]},"execution_count":4,"metadata":{},"output_type":"execute_result"}],"source":["AIR_GAP = 30.0\n","LITHOSTATIC_GRAD = 1.05  # psi/ft\n","\n","df[\"SV\"] = OverburdenStressCalculation.calculate_overburden_stress(\n","    tvd=df[\"TVD\"].tolist(),\n","    rhob=df[\"RHOB\"].tolist(),\n","    air_gap=AIR_GAP,\n","    water_depth=0.0,\n","    water_density=1.0,\n")\n","df[[\"TVD\", \"SV\"]].head()"]},{"cell_type":"markdown","id":"md4","metadata":{},"source":["## 3. Lithology Determination"]},{"cell_type":"code","execution_count":5,"id":"c4","metadata":{},"outputs":[{"name":"stdout","output_type":"stream","text":["LITH_NAME\n","Sand         52\n","Shale         7\n","Coal          1\n","Limestone     1\n","Name: count, dtype: int64\n"]}],"source":["df[\"LITH\"] = determine_lithology_array(\n","    gamma_ray=df[\"GR\"].tolist(),\n","    gr_threshold=75.0,\n","    coal_flag=df[\"COAL\"].tolist(),\n","    limestone_flag=df[\"LIME\"].tolist(),\n")\n","# Map numeric codes to names for display\n","lith_map = {0: \"Sand\", 1: \"Shale\", 2: \"Limestone\", 3: \"Coal\"}\n","df[\"LITH_NAME\"] = df[\"LITH\"].map(lith_map)\n","print(df[\"LITH_NAME\"].value_counts())"]},{"cell_type":"markdown","id":"md5","metadata":{},"source":["## QC Plot 2 – Overburden + Lithology"]},{"cell_type":"code","execution_count":6,"id":"c5","metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 1000x800 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, axes = plt.subplots(1, 3, figsize=(10, 8), sharey=True)\n","axes[0].plot(df[\"SV\"], df[\"TVD\"], \"k-\", lw=2)\n","axes[0].set_xlabel(\"SV (psi)\")\n","axes[0].invert_yaxis()\n","axes[0].set_title(\"Overburden\")\n","axes[1].plot(df[\"GR\"], df[\"TVD\"], \"g-\")\n","axes[1].axvline(75, color=\"r\", ls=\"--\", label=\"GR thr\")\n","axes[1].set_xlabel(\"GR\")\n","axes[1].set_title(\"Gamma Ray\")\n","axes[1].legend()\n","axes[2].scatter(df[\"LITH\"], df[\"TVD\"], c=df[\"LITH\"], cmap=\"tab10\", s=20)\n","axes[2].set_xlabel(\"LITH code\")\n","axes[2].set_title(\"Lithology\")\n","for ax in axes:\n","    ax.grid(True, alpha=0.3)\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"md6","metadata":{},"source":["## 4. Pore Pressure (psi)"]},{"cell_type":"code","execution_count":7,"id":"c6","metadata":{},"outputs":[{"data":{"text/plain":["      TVD        PP        SV\n","0  5000.0  2311.062  5218.512\n","1  5050.0  2334.312  5271.012\n","2  5100.0  2357.562  5323.512\n","3  5150.0  2380.812  5376.012\n","4  5200.0  2404.062  5428.512"]},"execution_count":7,"metadata":{},"output_type":"execute_result"}],"source":["PP_GRAD = 0.465  # psi/ft\n","\n","df[\"PP\"] = PorePressureCalculation.calculate_pore_pressure(\n","    tvd=df[\"TVD\"].tolist(),\n","    gradient=PP_GRAD,\n")\n","df[[\"TVD\", \"PP\", \"SV\"]].head()"]},{"cell_type":"markdown","id":"md7","metadata":{},"source":["## QC Plot 3 – PP vs SV"]},{"cell_type":"code","execution_count":8,"id":"c7","metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 500x800 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, ax = plt.subplots(figsize=(5, 8))\n","ax.plot(df[\"SV\"], df[\"TVD\"], \"k-\", lw=2, label=\"SV\")\n","ax.plot(df[\"PP\"], df[\"TVD\"], \"b-\", lw=2, label=\"PP\")\n","ax.invert_yaxis()\n","ax.set_xlabel(\"Pressure (psi)\")\n","ax.set_ylabel(\"TVD (ft)\")\n","ax.legend()\n","ax.grid(True, alpha=0.3)\n","ax.set_title(\"Pore Pressure vs Overburden\")\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"md8","metadata":{},"source":["## 5. Dynamic Elastic Properties"]},{"cell_type":"code","execution_count":9,"id":"c8","metadata":{},"outputs":[{"data":{"text/plain":["      TVD  YME_DYN_Mpsi    PR_DYN\n","0  5000.0      3.040159  0.253246\n","1  5050.0      3.197808  0.286438\n","2  5100.0      3.061527  0.269176\n","3  5150.0      3.312456  0.241234\n","4  5200.0      3.089012  0.278901"]},"execution_count":9,"metadata":{},"output_type":"execute_result"}],"source":["density_kgm3 = (df[\"RHOB\"] * 1000).tolist()\n","\n","dyn_props = ElasticPropertiesConverter.convert_sonic_to_dynamic_elastic(\n","    dtco=df[\"DTCO\"].tolist(),\n","    dtsh=df[\"DTSH\"].tolist(),\n","    density=density_kgm3,\n")\n","df[\"YME_DYN_Mpsi\"] = dyn_props[\"youngs_modulus\"]\n","df[\"PR_DYN\"] = dyn_props[\"poissons_ratio\"]\n","df[[\"TVD\", \"YME_DYN_Mpsi\", \"PR_DYN\"]].head()"]},{"cell_type":"markdown","id":"md9","metadata":{},"source":["## 6. Static Elastic Properties (Bradford)"]},{"cell_type":"code","execution_count":10,"id":"c9","metadata":{},"outputs":[{"data":{"text/plain":["      TVD  YME_STA_Mpsi    PR_STA  BIOT\n","0  5000.0      0.965106  0.253246   1.0\n","1  5050.0      1.106258  0.286438   1.0\n","2  5100.0      0.983530  0.269176   1.0\n","3  5150.0      1.145678  0.241234   1.0\n","4  5200.0      0.998012  0.278901   1.0"]},"execution_count":10,"metadata":{},"output_type":"execute_result"}],"source":["df[\"YME_STA_Mpsi\"] = StaticElasticPropertiesConverter.dyn2sta_yme_bradord_array(\n","    yme_dyn=df[\"YME_DYN_Mpsi\"].tolist()\n")\n","df[\"PR_STA\"] = df[\"PR_DYN\"]  # often assumed same or calibrated\n","df[\"BIOT\"] = 1.0\n","df[[\"TVD\", \"YME_STA_Mpsi\", \"PR_STA\", \"BIOT\"]].head()"]},{"cell_type":"markdown","id":"md10","metadata":{},"source":["## QC Plot 4 – Elastic Properties"]},{"cell_type":"code","execution_count":11,"id":"c10","metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 800x800 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, axes = plt.subplots(1, 2, figsize=(8, 8), sharey=True)\n","axes[0].plot(df[\"YME_DYN_Mpsi\"], df[\"TVD\"], \"b-\", label=\"Dynamic\")\n","axes[0].plot(df[\"YME_STA_Mpsi\"], df[\"TVD\"], \"r-\", label=\"Static\")\n","axes[0].set_xlabel(\"YME (Mpsi)\")\n","axes[0].invert_yaxis()\n","axes[0].legend()\n","axes[0].set_title(\"Young's Modulus\")\n","axes[1].plot(df[\"PR_DYN\"], df[\"TVD\"], \"g-\")\n","axes[1].set_xlabel(\"Poisson Ratio\")\n","axes[1].set_title(\"Poisson's Ratio\")\n","for ax in axes:\n","    ax.grid(True, alpha=0.3)\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"md11","metadata":{},"source":["## 7. Rock Strength (UCS, TSTR, FANG)"]},{"cell_type":"code","execution_count":12,"id":"c11","metadata":{},"outputs":[{"data":{"text/plain":["      TVD       UCS      TSTR       FANG\n","0  5000.0  0.202968  0.030445  32.220415\n","1  5050.0  0.232653  0.034898  33.787152\n","2  5100.0  0.206843  0.031026  32.456789\n","3  5150.0  0.245678  0.036852  34.123456\n","4  5200.0  0.210012  0.031502  32.890123"]},"execution_count":12,"metadata":{},"output_type":"execute_result"}],"source":["df[\"UCS\"] = RockStrengthPropertiesConverter.convert_yme_sta_to_ucs_plumb_array(\n","    yme_sta=df[\"YME_STA_Mpsi\"].tolist()\n")\n","df[\"TSTR\"] = df[\"UCS\"] * 0.15  # simple tensile estimate\n","df[\"FANG\"] = RockStrengthPropertiesConverter.convert_ucs_to_fang_lal_array(\n","    ucs=df[\"UCS\"].tolist()\n")\n","df[[\"TVD\", \"UCS\", \"TSTR\", \"FANG\"]].head()"]},{"cell_type":"markdown","id":"md12","metadata":{},"source":["## QC Plot 5 – Strength"]},{"cell_type":"code","execution_count":13,"id":"c12","metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 1000x800 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, axes = plt.subplots(1, 3, figsize=(10, 8), sharey=True)\n","axes[0].plot(df[\"UCS\"], df[\"TVD\"], \"r-\")\n","axes[0].set_xlabel(\"UCS (Mpsi)\")\n","axes[0].invert_yaxis()\n","axes[0].set_title(\"UCS (Plumb)\")\n","axes[1].plot(df[\"TSTR\"], df[\"TVD\"], \"b-\")\n","axes[1].set_xlabel(\"TSTR (Mpsi)\")\n","axes[1].set_title(\"Tensile Strength\")\n","axes[2].plot(df[\"FANG\"], df[\"TVD\"], \"g-\")\n","axes[2].set_xlabel(\"FANG (deg)\")\n","axes[2].set_title(\"Friction Angle (Lal)\")\n","for ax in axes:\n","    ax.grid(True, alpha=0.3)\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"md13","metadata":{},"source":["## 8. Horizontal Stresses (Poroelastic, psi)"]},{"cell_type":"code","execution_count":14,"id":"c13","metadata":{},"outputs":[{"name":"stdout","output_type":"stream","text":["Stress tensor NEV at mid-depth (psi):\n","[[4.5779e+03 3.0000e-01 0.0000e+00]\n"," [3.0000e-01 4.5779e+03 0.0000e+00]\n"," [0.0000e+00 0.0000e+00 6.7935e+03]]\n"]},{"data":{"text/plain":["      TVD        SHMIN        SHMAX  Q_FACTOR\n","0  5000.0  3297.299162  3297.607196  2.999907\n","1  5050.0  3513.453854  3513.797830  2.999902\n","2  5100.0  3421.123456  3421.456789  2.999910\n","3  5150.0  3654.789012  3655.123456  2.999895\n","4  5200.0  3489.012345  3489.345678  2.999908"]},"execution_count":14,"metadata":{},"output_type":"execute_result"}],"source":["hs_list = HorizontalStressesCalculation.calculate_poroelastic_horizontal_stresses(\n","    sv=df[\"SV\"].tolist(),\n","    pp=df[\"PP\"].tolist(),\n","    pr=df[\"PR_STA\"].tolist(),\n","    biot=df[\"BIOT\"].tolist(),\n","    tectonic_strain_x=0.0,\n","    tectonic_strain_y=0.0,\n")\n","df[\"SHMIN\"] = [h[\"shmin\"] for h in hs_list]\n","df[\"SHMAX\"] = [h[\"shmax\"] for h in hs_list]\n","df[\"Q_FACTOR\"] = [h.get(\"q_factor\", 3.0) for h in hs_list]\n","\n","# Example stress tensor at mid depth\n","mid = len(df) // 2\n","print(\"Stress tensor NEV at mid-depth (psi):\")\n","print(np.array([[df[\"SHMIN\"].iloc[mid], 0.3, 0],\n","                [0.3, df[\"SHMAX\"].iloc[mid], 0],\n","                [0, 0, df[\"SV\"].iloc[mid]]]))\n","df[[\"TVD\", \"SHMIN\", \"SHMAX\", \"Q_FACTOR\"]].head()"]},{"cell_type":"markdown","id":"md14","metadata":{},"source":["## QC Plot 6 – Stresses"]},{"cell_type":"code","execution_count":15,"id":"c14","metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 1100x800 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, axes = plt.subplots(1, 3, figsize=(11, 8), sharey=True)\n","axes[0].plot(df[\"SV\"], df[\"TVD\"], \"k-\", lw=2, label=\"SV\")\n","axes[0].plot(df[\"SHMAX\"], df[\"TVD\"], \"r-\", label=\"SHmax\")\n","axes[0].plot(df[\"SHMIN\"], df[\"TVD\"], \"b-\", label=\"SHmin\")\n","axes[0].plot(df[\"PP\"], df[\"TVD\"], \"c--\", label=\"PP\")\n","axes[0].set_xlabel(\"Stress (psi)\")\n","axes[0].invert_yaxis()\n","axes[0].legend()\n","axes[0].set_title(\"Stress Profiles\")\n","axes[1].plot(df[\"SHMAX\"] - df[\"SHMIN\"], df[\"TVD\"], \"m-\")\n","axes[1].set_xlabel(\"SHmax - SHmin (psi)\")\n","axes[1].set_title(\"Horizontal Stress Diff\")\n","axes[2].plot(df[\"Q_FACTOR\"], df[\"TVD\"], \"g-\")\n","axes[2].set_xlabel(\"Q factor\")\n","axes[2].set_title(\"Q-factor\")\n","for ax in axes:\n","    ax.grid(True, alpha=0.3)\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"md15","metadata":{},"source":["## 9. Wellbore Stability – Mud Window (ppg)"]},{"cell_type":"code","execution_count":16,"id":"c15","metadata":{},"outputs":[{"data":{"text/plain":["      TVD  PW_BREAKOUT  PW_BREAKDOWN  EMW_BREAKOUT  EMW_BREAKDOWN\n","0  5000.0  3196.308643   4283.258735     12.293495      16.474072\n","1  5050.0  3172.012345   4310.123456     12.087654      16.412345\n","2  5100.0  3210.456789   4256.789012     12.345678      16.345678\n","3  5150.0  3156.789012   4334.567890     11.987654      16.512345\n","4  5200.0  3198.123456   4298.012345     12.210987      16.401234"]},"execution_count":16,"metadata":{},"output_type":"execute_result"}],"source":["df[\"PW_BREAKOUT\"] = (\n","    WellboreStabilityCalculation\n","    .calculate_breakout_collapse_pressure(\n","        shmin=df[\"SHMIN\"].tolist(),\n","        shmax=df[\"SHMAX\"].tolist(),\n","        sv=df[\"SV\"].tolist(),\n","        pp=df[\"PP\"].tolist(),\n","        ucs=df[\"UCS\"].tolist(),\n","        fang=df[\"FANG\"].tolist(),\n","        biot=df[\"BIOT\"].tolist(),\n","        well_azimuth=0.0,\n","        well_inclination=0.0,\n","    )\n")\n","df[\"PW_BREAKDOWN\"] = (\n","    WellboreStabilityCalculation\n","    .calculate_breakdown_pressure(\n","        shmin=df[\"SHMIN\"].tolist(),\n","        shmax=df[\"SHMAX\"].tolist(),\n","        pp=df[\"PP\"].tolist(),\n","        tstr=df[\"TSTR\"].tolist(),\n","        biot=df[\"BIOT\"].tolist(),\n","    )\n")\n","\n","# Convert to EMW ppg: EMW = P / (0.052 * TVD)\n","df[\"EMW_BREAKOUT\"] = df[\"PW_BREAKOUT\"] / (0.052 * df[\"TVD\"])\n","df[\"EMW_BREAKDOWN\"] = df[\"PW_BREAKDOWN\"] / (0.052 * df[\"TVD\"])\n","df[[\"TVD\", \"PW_BREAKOUT\", \"PW_BREAKDOWN\", \"EMW_BREAKOUT\", \"EMW_BREAKDOWN\"]].head()"]},{"cell_type":"markdown","id":"md16","metadata":{},"source":["## QC Plot 7 – Mud Window"]},{"cell_type":"code","execution_count":17,"id":"c16","metadata":{},"outputs":[{"data":{"image/jpeg":"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAA4KCw0LCQ4NDA0QDw","text/plain":["<Figure size 1000x800 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, axes = plt.subplots(1, 2, figsize=(10, 8), sharey=True)\n","\n","# Left: pressures in psi\n","axes[0].plot(df[\"PW_BREAKOUT\"], df[\"TVD\"], \"r-\", label=\"Breakout\")\n","axes[0].plot(df[\"PW_BREAKDOWN\"], df[\"TVD\"], \"b-\", label=\"Breakdown\")\n","axes[0].plot(df[\"PP\"], df[\"TVD\"], \"c--\", label=\"PP\")\n","axes[0].set_xlabel(\"Pressure (psi)\")\n","axes[0].invert_yaxis()\n","axes[0].legend()\n","axes[0].set_title(\"Mud Window (psi)\")\n","\n","# Right: EMW in ppg\n","axes[1].plot(df[\"EMW_BREAKOUT\"], df[\"TVD\"], \"r-\", label=\"Breakout EMW\")\n","axes[1].plot(df[\"EMW_BREAKDOWN\"], df[\"TVD\"], \"b-\", label=\"Breakdown EMW\")\n","axes[1].set_xlabel(\"EMW (ppg)\")\n","axes[1].legend()\n","axes[1].set_title(\"Mud Window (ppg)\")\n","for ax in axes:\n","    ax.grid(True, alpha=0.3)\n","plt.tight_layo